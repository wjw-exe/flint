# bubble_sort.fl — 冒泡排序 (Flint v2.2)
# 语法完全贴近 Python: for range / if / 列表索引 / 复合赋值 / for-in 遍历
def main() -> i32:
    xs: list[i32] = [64, 34, 25, 12, 22, 11, 90, 5]
    n: i32 = len(xs)

    # 冒泡: 每轮把最大值浮到末尾
    for i in range(n - 1):
        for j in range(n - 1 - i):
            if xs[j] > xs[j + 1]:
                tmp: i32 = xs[j]
                xs[j] = xs[j + 1]
                xs[j + 1] = tmp

    # 打印排序结果
    for x in xs:
        print(x)
    return 0
