{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flint: 运行当前 .fl 文件 (VM)",
      "type": "process",
      "command": "${workspaceFolder}\\dist\\flint.exe",
      "args": ["run", "${file}"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Flint: 原生编译运行 (--native, 需 gcc)",
      "type": "process",
      "command": "${workspaceFolder}\\dist\\flint.exe",
      "args": ["run", "--native", "${file}"],
      "group": "build",
      "problemMatcher": []
    }
  ]
}